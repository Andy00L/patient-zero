# Patient Zero environment, example values.
#
# Copy this file to .env, put a generated token in HYDRA_AUTH_TOKEN, and both halves
# of the stack read it:
#   - docker compose interpolates HYDRA_AUTH_TOKEN out of .env when it starts HydraDB
#   - Bun loads .env for `bun run hydra:health`, `bun run dev`, and every other script
#
# Every value below is a real local default, so the only line that has to change is
# the token. .env holds a secret and is git-ignored; this file never does.
#
# Full run sequence and failure modes: docs/RUNNING.md
# Where these facts come from: docs/HYDRADB.md

# ---------------------------------------------------------------------------------
# The one value you must set
# ---------------------------------------------------------------------------------

# Shared auth token. HydraDB refuses to start when it is shorter than 32 characters
# or contains "change-me", and the same rule is enforced twice more before anything
# runs: by the hydra-init service in docker-compose.yml, and by
# readHydraConfigFromEnv in src/lib/hydra/config.ts.
#
# The node reads it from a file (GRAPH_AUTH_TOKEN_FILE), which hydra-init writes into
# the shared volume from this variable, so the secret never enters the image or a
# committed file. The app sends the same value as an HTTP bearer credential, and as
# the Bolt password.
#
# Generate one:
#   openssl rand -hex 32
# or, without openssl:
#   LC_ALL=C tr -dc 'A-Za-z0-9' < /dev/urandom | head -c 48; echo
#
# No default, and the placeholder below is deliberately invalid.
HYDRA_AUTH_TOKEN=change-me-with-the-generated-value-above

# ---------------------------------------------------------------------------------
# Where HydraDB is
# ---------------------------------------------------------------------------------

# Transport the app and the health check use. Values: http, bolt. Default: http.
# HTTP is the default because it needs no version negotiation; Bolt has no request
# body cap but has to agree a protocol version with the server, which this project
# cannot verify without a running node (docs/HYDRADB.md section 11).
HYDRA_TRANSPORT=http

# Base URL of the query API, POST /v1/graphs/{graph_id}/query. Plain http on purpose:
# the compose file starts the node with GRAPH_ALLOW_PLAINTEXT=true, so 8443 carries
# HTTP and not HTTPS. Default: http://127.0.0.1:8443
HYDRA_HTTP_URL=http://127.0.0.1:8443

# Bolt URI, used only when HYDRA_TRANSPORT=bolt or `bun run hydra:health --bolt`.
# Must match GRAPH_ADVERTISED_BOLT_ADDR on the server, because that is the address the
# node tells the driver to reconnect to. Default: bolt://127.0.0.1:7687
HYDRA_BOLT_URL=bolt://127.0.0.1:7687

# Admin origin serving /readyz, /livez and /metrics. Read by scripts/hydra-health.ts
# only. Leave it unset for a local run: the script then derives the admin URL from
# HYDRA_HTTP_URL by swapping port 8443 for 9090, and prints that it derived it. Set it
# when the ports are remapped or the node is remote, since the derivation would
# otherwise probe an endpoint that is not there.
# Default: derived, http://127.0.0.1:9090 for the values above.
# HYDRA_ADMIN_URL=http://127.0.0.1:9090

# ---------------------------------------------------------------------------------
# Which graph, and which cell
# ---------------------------------------------------------------------------------
# Each of these must equal its GRAPH_* counterpart in docker-compose.yml. A mismatch
# is not a connection error: the namespace is compared for equality on every request,
# and a wrong cell id is a 422 with no server-side default.

# Graph id, part of the query URL path. Matches GRAPH_ID. Default: default
HYDRA_GRAPH_ID=default

# Namespace, sent as the X-Graph-Namespace header. Matches GRAPH_NAMESPACE.
# Default: default
HYDRA_NAMESPACE=default

# Cell id, mandatory in every HTTP request body. Must be one of GRAPH_CELLS, and
# matches GRAPH_CELL_ID for a single-node run. Default: cell-0
HYDRA_CELL_ID=cell-0

# Bolt database name. Matches GRAPH_DATABASE. Ignored by the HTTP transport.
# Default: default
HYDRA_DATABASE=default

# ---------------------------------------------------------------------------------
# Query limits
# ---------------------------------------------------------------------------------

# Per-query server-side timeout, in milliseconds. Sent as timeout_ms in the request
# body; the client adds its own connect and transfer headroom on top. The server
# rejects a timeout with 408, never 429. Default: 30000 (30 seconds), which is also
# the server's own max_query_runtime_ms default.
HYDRA_QUERY_TIMEOUT_MS=30000

# Rows per page for cursor pagination, in rows. Set explicitly because the HTTP client
# default (256) and the server default (1024) differ, and a page size that lands in
# the request body as a misspelled field would silently become the server default.
# Default: 1024
HYDRA_PAGE_SIZE=1024

# ---------------------------------------------------------------------------------
# The local persistence scanner
# ---------------------------------------------------------------------------------

# Switches on POST /api/local-scan and the scan console on /local. Only the exact
# value "enabled" opens the gate; anything else, including "true" and "1", leaves it
# closed. Unset by default on purpose: this is the one route that reads the
# filesystem of the machine running it, and with the gate closed it answers 404 and
# parses no request body at all.
#
# Even with the gate open, a scan still needs an explicit consent flag per request and
# refuses any path outside the directory the server was started in. Findings carry an
# indicator id, a severity, a root-relative path and a line number, never a matched
# line. Full rules: the header of src/app/api/local-scan/route.ts.
#
# No default: unset means the route does not exist.
# HYDRA_LOCAL_SCAN=enabled

# ---------------------------------------------------------------------------------
# Running without HydraDB
# ---------------------------------------------------------------------------------

# Path to an exported graph snapshot. When set, the app answers from the in-process
# MemoryGraph instead of a live node, and states in the UI which source answered, so a
# snapshot answer is never presented as a live one. Leave unset for a live run.
# No default: unset means "no snapshot".
# HYDRA_SNAPSHOT_PATH=data/graph/snapshot.json
